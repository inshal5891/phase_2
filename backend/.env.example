# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/todo_app_db

# JWT Configuration
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Neon PostgreSQL Configuration (if using Neon)
NEON_DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Application Settings
APP_ENV=development
DEBUG=True
